---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getPostDescription } from "../../utils/description";

export async function getStaticPaths() {
  const allPosts = await getCollection("notes");
  
  const uniqueCategories = [
    ...new Set(
      allPosts.flatMap((post) => post.data.categories || [])
    )
  ];

  return uniqueCategories.map((category) => {
    const filteredPosts = allPosts
      .filter((post) => (post.data.categories || []).includes(category))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    
    return {
      params: { category: category.toLowerCase().replace(/\s+/g, "-") },
      props: { category, posts: filteredPosts },
    };
  });
}

const { category, posts } = Astro.props;
---

<Layout title={`${category} - Jabee's Blog`} fullWidth={true}>
  <div class="mb-12 mt-8 text-center max-w-4xl mx-auto">
    <a href="/categories" class="text-sm font-medium text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-colors mb-6 inline-block">
      &larr; Back to Categories
    </a>
    <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl mb-4">
      {category}
    </h1>
    <p class="text-lg text-gray-600 dark:text-gray-400">
      Showing {posts.length} article{posts.length !== 1 ? 's' : ''} in this category.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-4xl mx-auto px-4">
    {
      posts.map((post) => {
        let imageUrl = null;
        let imageObj = null;
        if (post.data.coverImage) {
          if (typeof post.data.coverImage === 'string') {
            imageUrl = post.data.coverImage;
          } else {
            imageObj = post.data.coverImage;
            imageUrl = post.data.coverImage.src;
          }
        } else if (post.body && post.body.includes("![Dummy Image](")) {
          const match = post.body.match(/!\[.*?\]\((.*?)\)/);
          if (match && match[1]) {
            imageUrl = match[1];
          }
        }
        if (!imageUrl && !imageObj) imageUrl = "/favicon.ico";

        return (
          <article class="group relative flex flex-col sm:flex-row items-start gap-5">
            <div class="w-full sm:w-36 h-48 sm:h-24 shrink-0 overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800">
              {imageObj ? (
                <Image
                  src={imageObj}
                  alt={post.data.title}
                  format="webp"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <img
                  src={imageUrl}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              )}
            </div>
            <div class="flex flex-col flex-1 w-full">
              <div class="flex items-center gap-x-4 text-xs mb-3">
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-gray-500 dark:text-gray-400 font-medium"
                >
                  {post.data.date.toLocaleDateString("en-US", {
                    month: "long",
                    day: "numeric",
                    year: "numeric",
                  })}
                </time>
                {post.data.categories && post.data.categories.length > 0 && (
                  <a
                    href={`/categories/${post.data.categories[0].toLowerCase().replace(/\s+/g, "-")}`}
                    class="relative z-10 rounded-full bg-gray-50 dark:bg-gray-800 px-3 py-1 font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
                  >
                    {post.data.categories[0]}
                  </a>
                )}
              </div>
              <div class="group">
                <h3 class="mt-3 text-xl font-semibold leading-6 text-gray-900 dark:text-white group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors">
                  <a href={`/notes/${post.id.replace(/\/(?:index)?\.mdx?$/, '').replace(/\.mdx?$/, '')}`}>
                    <span class="absolute inset-0" />
                    {post.data.title}
                  </a>
                </h3>
                <p class="mt-2 line-clamp-2 text-sm leading-6 text-gray-600 dark:text-gray-400">
                  {getPostDescription(post) || "點擊閱讀完整文章..."}
                </p>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</Layout>
