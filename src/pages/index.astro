---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const recentPosts = posts.slice(0, 5);

// Calculate total word count across all posts
const totalWordCount = posts.reduce((acc, post) => {
  const content = post.body || '';
  const words = content.match(/[\u4e00-\u9fa5]|\w+/g);
  return acc + (words ? words.length : 0);
}, 0);
---

<Layout
  title="Jabee's Blog | Jabee姜 - 人生不只寫code"
  description="Jabee 的個人部落格 - 分享科技、攝影、旅遊、重機生活與日常隨筆。Jabee姜，中正資工碩士生，用文字記錄人生的每一刻。"
>
  <div class="max-w-4xl mx-auto">
    <section class="mb-16 mt-8">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl mb-4">Jabee’s Blog - 人生不只寫code👋</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl">
        歡迎來到我的 Blog<br/>
        Jabee 的座右銘: 資料要備份、Format 要謹慎<br/>
        有問題歡迎寄信給我！
      </p>
      <div class="mt-6 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gray-100 dark:bg-gray-800 text-sm font-medium text-gray-700 dark:text-gray-300">
        <svg class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
        目前累積了 {totalWordCount.toLocaleString()} 個字啦！
      </div>
    </section>

    <section>
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-white tracking-tight">Recent Posts</h2>
        <a href="/notes" class="text-sm font-medium text-gray-600 hover:text-black dark:text-gray-400 dark:hover:text-white group flex items-center transition-colors">
          view all
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>

      <div class="space-y-10">
        {recentPosts.map((post) => {
          // Simple logic to extract image from mdx body if it exists, or provide a default fallback
          let imageUrl = null;
          let imageObj = null;
          if (post.data.coverImage) {
            if (typeof post.data.coverImage === 'string') {
              imageUrl = post.data.coverImage;
            } else {
              imageObj = post.data.coverImage;
              imageUrl = post.data.coverImage.src;
            }
          } else if (post.body && post.body.includes('![Dummy Image](')) {
            const match = post.body.match(/!\[.*?\]\((.*?)\)/);
            if (match && match[1]) {
              imageUrl = match[1];
            }
          }
          if (!imageUrl && !imageObj) imageUrl = '/favicon.ico'; // Fallback if no image

          return (
            <article class="group relative flex flex-col sm:flex-row items-start gap-5">
              <div class="w-full sm:w-36 h-48 sm:h-24 shrink-0 overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800">
                {imageObj ? (
                  <Image src={imageObj} alt={post.data.title} format="webp" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                ) : (
                  <img src={imageUrl} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                )}
              </div>
              <div class="flex flex-col flex-1 w-full">
                <div class="flex items-center gap-x-1 text-xs mb-2">
                  <time datetime={post.data.date.toISOString()} class="w-[100px] shrink-0 text-gray-500 dark:text-gray-400 font-medium">
                    {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                  </time>
                  {post.data.categories && post.data.categories.length > 0 && (
                    <a href={`/categories/${post.data.categories[0]}`} class="relative z-10 rounded-full bg-gray-100 dark:bg-gray-800 px-2 py-1 font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                      {post.data.categories[0]}
                    </a>
                  )}
                </div>
                <div class="group">
                  <h3 class="text-xl font-semibold leading-6 text-gray-900 dark:text-white group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors">
                    <a href={`/notes/${post.id.replace(/\/(?:index)?\.mdx?$/, '').replace(/\.mdx?$/, '')}`}>
                      <span class="absolute inset-0"></span>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="mt-2 line-clamp-2 text-sm leading-6 text-gray-600 dark:text-gray-400">
                    {post.data.description || '點擊閱讀完整文章...'}
                  </p>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </div>
</Layout>
