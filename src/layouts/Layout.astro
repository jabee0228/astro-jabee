---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, SITE_OG_IMAGE, SITE_AUTHOR } from '../consts';
import ImageZoom from '../components/ImageZoom.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	fullWidth?: boolean;
	image?: string;
	type?: 'website' | 'article';
	publishDate?: Date;
	modifiedDate?: Date;
	author?: string;
	tags?: string[];
	extraJsonLd?: Record<string, any>[];
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	fullWidth = false,
	image = SITE_OG_IMAGE,
	type = 'website',
	publishDate,
	modifiedDate,
	author = SITE_AUTHOR.name,
	tags = [],
	extraJsonLd = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageURL = image.startsWith('http') ? image : new URL(image, SITE_URL).href;

// JSON-LD Structured Data
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": SITE_TITLE,
	"url": SITE_URL,
	"description": SITE_DESCRIPTION,
	"author": {
		"@type": "Person",
		"name": SITE_AUTHOR.name,
		"url": SITE_URL + "/about",
		"jobTitle": SITE_AUTHOR.title,
	},
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "首頁",
			"item": SITE_URL,
		},
	],
};
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<meta name="author" content={author} />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Favicons -->
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<!-- RSS Feed -->
		<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('/rss.xml', SITE_URL).href} />

		<!-- Open Graph / Facebook / LINE -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:site_name" content="Jabee's Blog" />
		<meta property="og:locale" content="zh_TW" />
		{publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
		{modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}
		{tags.length > 0 && tags.map(tag => <meta property="article:tag" content={tag} />)}

		<title>{title}</title>
		<ClientRouter />

		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-C117DRX8W6"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			// 初始網頁載入時的追蹤
			gtag('config', 'G-C117DRX8W6');

			// 支援 Astro View Transitions 的換頁追蹤
			document.addEventListener('astro:page-load', () => {
				gtag('config', 'G-C117DRX8W6', {
					page_path: window.location.pathname,
				});
			});
		</script>

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		{extraJsonLd.length === 0 && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
		{extraJsonLd.map(schema => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
		
        <script is:inline>
            // Theme initialization logic to avoid FOUC
            function applyTheme() {
              const theme = (() => {
                if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                  return localStorage.getItem('theme');
                }
                if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                  return 'dark';
                }
                return 'light';
              })();
            
              if (theme === 'light') {
                document.documentElement.classList.remove('dark');
              } else {
                document.documentElement.classList.add('dark');
              }
              window.localStorage.setItem('theme', theme || 'light');
            }

            applyTheme();

            // Re-apply theme when navigating to a new page using Astro View Transitions
            document.addEventListener('astro:after-swap', applyTheme);
        </script>
	</head>
	<body class="min-h-screen flex flex-col font-sans bg-[#F5F5F5] dark:bg-[#1D1E20] text-gray-900 dark:text-gray-100 transition-colors duration-300">
		<Header />
		<main class="flex-grow max-w-7xl mx-auto w-full px-4 sm:px-8 lg:px-12 py-8 mt-16">
			<slot />
		</main>
		<Footer />
		<ImageZoom />
	</body>
</html>
