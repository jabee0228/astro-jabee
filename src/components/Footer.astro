  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col items-center justify-center">
    <p class="text-sm text-gray-500 dark:text-gray-400">&copy; {currentYear} Jabee's Blog <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" class="underline hover:text-gray-700 dark:hover:text-gray-200 transition-colors">CC BY-SA</a></p>
  </div>
</footer>
